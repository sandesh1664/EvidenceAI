{
    admin off
    auto_https disable_redirects
    servers {
        timeouts {
            read_header 10s
            read_body 120s
            write 150s
            idle 2m
        }
    }
    http_port 8080
    https_port 8443
    email {$ACME_EMAIL}
    log default {
        level ERROR
        format filter {
            wrap json
            fields {
                request delete
                err_trace delete
            }
        }
    }
}
http://:8080 {
    handle /_proxy/health {
        respond "healthy" 200
    }
    handle {
        redir {$PUBLIC_ORIGIN}{uri} 308
    }
}
https://{$SITE_HOST}:8443 {
    import /etc/caddy/tls.caddy
    request_body {
        max_size 21037056
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @private path /api/v1/ops/* /metrics /docs /redoc /openapi.json
    route {
        respond @private 404
        handle /api/* {
            header Cache-Control "private, no-store"
            reverse_proxy api:8000 {
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-For {remote_host}
                header_up -Forwarded
                transport http {
                    dial_timeout 5s
                    response_header_timeout 130s
                }
                flush_interval -1
            }
        }
        handle {
            reverse_proxy web:3000 {
                header_up X-Forwarded-Proto https
                header_up -Forwarded
                transport http {
                    dial_timeout 5s
                    response_header_timeout 130s
                }
            }
        }
    }
}
