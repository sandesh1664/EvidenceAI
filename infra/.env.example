# Copy to an operator-owned file outside Git and select with --env-file.
DEPLOY_PROJECT=evidenceai-staging
SITE_HOST=evidenceai.localhost
PUBLIC_ORIGIN=https://evidenceai.localhost:18443
ACME_EMAIL=operator@example.invalid
API_IMAGE=evidenceai-api:REPLACE_WITH_RELEASE_SHA
WEB_IMAGE=evidenceai-web:REPLACE_WITH_RELEASE_SHA
BACKUP_IMAGE=evidenceai-backup:REPLACE_WITH_RELEASE_SHA
PROXY_IMAGE=evidenceai-proxy:REPLACE_WITH_RELEASE_SHA
SECRETS_DIR=/absolute/private/evidenceai-secrets
AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
BACKUP_RETENTION_DAYS=14
# Providers stay disabled unless explicitly opted into after privacy review.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=fake-hash-v1
EMBEDDING_DIMENSIONS=128
EMBEDDING_HOSTED_ALLOWED=false
LLM_PROVIDER=disabled
LLM_MODEL=mock-extractive-v1
LLM_HOSTED_ALLOWED=false
