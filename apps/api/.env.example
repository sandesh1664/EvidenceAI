APP_NAME=EvidenceAI API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5433/YOUR_DATABASE
# Explicitly opt into HTTP for local development only. Rejected in staging/production.
AUTH_ALLOW_INSECURE_HTTP=true
TRUSTED_FRONTEND_ORIGINS=["http://localhost:3000"]
SESSION_TTL_SECONDS=86400
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=300
