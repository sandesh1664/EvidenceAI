APP_NAME=EvidenceAI API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5433/YOUR_DATABASE
# Explicitly opt into HTTP for local development only. Rejected in staging/production.
AUTH_ALLOW_INSECURE_HTTP=true
TRUSTED_FRONTEND_ORIGINS=["http://localhost:3000"]
SESSION_TTL_SECONDS=86400
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=300

# Optional absolute private directory; default is <project>/storage/documents.
# DOCUMENT_STORAGE_ROOT=/absolute/private/path/documents
DOCUMENT_UPLOAD_MAX_BYTES=20971520
DOCUMENT_CHUNK_SIZE=1600
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_MAX_CHUNKS=10000
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_TEXT_CHARS=2000000
DOCUMENT_VALIDATION_TIMEOUT=5
DOCUMENT_PROCESSING_TIMEOUT=30
DOCUMENT_PARSER_MEMORY_MB=512
DOCUMENT_MAX_ATTEMPTS=3
DOCUMENT_JOB_LEASE_SECONDS=120

# No outbound embedding requests by default. Use fake for offline development.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=fake-hash-v1
EMBEDDING_REVISION=1
EMBEDDING_DIMENSIONS=128
EMBEDDING_HOSTED_ALLOWED=false
# Hosted opt-in requires privacy review and a backend-only OPENAI_API_KEY.
# OPENAI_API_KEY=replace-via-secret-manager
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INPUT_MAX_BYTES=8000
EMBEDDING_HTTP_TIMEOUT_SECONDS=10
EMBEDDING_REQUEST_BUDGET_SECONDS=30
EMBEDDING_PROVIDER_ATTEMPTS=3
EMBEDDING_JOB_MAX_ATTEMPTS=3
EMBEDDING_JOB_LEASE_SECONDS=120
SEARCH_MIN_SIMILARITY=0.25

# Stateless grounded answers; no hosted generation requests by default.
# For offline development use mock + mock-extractive-v1 and indexed fake embeddings.
LLM_PROVIDER=disabled
LLM_MODEL=mock-extractive-v1
LLM_REVISION=1
LLM_HOSTED_ALLOWED=false
# Hosted example: openai / gpt-5.4-mini-2026-03-17, with opt-in and backend OPENAI_API_KEY.
# Only configure temperature for models explicitly supporting it.
LLM_TEMPERATURE_SUPPORTED=false
# LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1000
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ATTEMPTS=2
RAG_REQUEST_TIMEOUT_SECONDS=45
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.35
RAG_CONTEXT_TOKEN_BUDGET=4096
RAG_INPUT_TOKEN_BUDGET=12000
RAG_MAX_CLAIMS=4
# All workers must agree; leave DB pool headroom for revalidation and other work.
RAG_CONCURRENT_GENERATIONS=4

# Bounded user-question history; prior assistant answers are never fresh evidence.
CONVERSATION_HISTORY_MESSAGES=6
CONVERSATION_HISTORY_TOKEN_BUDGET=1500
# Durable turn lease; PostgreSQL time, lazy recovery on message reads/submissions.
CONVERSATION_TURN_LEASE_SECONDS=180
